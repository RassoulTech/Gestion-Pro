# App
APP_DEBUG=false
NEXT_PUBLIC_APP_URL=http://localhost:3000
WHATSAPP_ADMIN_NUMBER=221773831364

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/gestionpro?schema=public"

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL=http://localhost:3000

# Google OAuth
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Email (Resend)
# 1) Créer un compte gratuit sur https://resend.com (100 emails/jour gratuits)
# 2) Aller dans API Keys → Create API Key → coller la valeur "re_..." ci-dessous
# 3) Pour envoyer à N'IMPORTE QUEL destinataire, vérifier un domaine dans
#    Resend → Domains, puis poser AUTH_EMAIL_FROM avec ce domaine.
#    Sinon (laissé vide), on utilise onboarding@resend.dev qui ne peut envoyer
#    qu'à l'adresse propriétaire du compte Resend (utile pour tester).
AUTH_RESEND_KEY=""
AUTH_EMAIL_FROM=""
CONTACT_TO_EMAIL=""

# Rate Limiting (Upstash)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# File Upload (UploadThing)
UPLOADTHING_SECRET=""
UPLOADTHING_APP_ID=""

# Sentry
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# SaaS Billing Features
BILLING_ENABLED="false"
PAYTECH_ENABLED="false"

# PayTech credentials (https://paytech.sn)
PAYTECH_API_KEY=""
PAYTECH_API_SECRET=""
PAYTECH_ENV="test"

# Daily trial expiration API CRON secret
CRON_SECRET="super-secret-cron-token-xyz"

