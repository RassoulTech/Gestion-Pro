# App
APP_DEBUG=false
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/gestionpro?schema=public"

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL=http://localhost:3000

# Google OAuth
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Email (Resend)
# 1) Créer un compte gratuit sur https://resend.com (100 emails/jour gratuits)
# 2) Aller dans API Keys → Create API Key → coller la valeur "re_..." ci-dessous
# 3) Pour envoyer à N'IMPORTE QUEL destinataire, vérifier un domaine dans
#    Resend → Domains, puis poser AUTH_EMAIL_FROM avec ce domaine.
#    Sinon (laissé vide), on utilise onboarding@resend.dev qui ne peut envoyer
#    qu'à l'adresse propriétaire du compte Resend (utile pour tester).
AUTH_RESEND_KEY=""
AUTH_EMAIL_FROM=""

# Rate Limiting (Upstash)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# File Upload (UploadThing)
UPLOADTHING_SECRET=""
UPLOADTHING_APP_ID=""

# Sentry
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# SaaS Billing Features
BILLING_ENABLED="false"
STRIPE_ENABLED="false"
PAYDUNYA_ENABLED="false"

# Stripe configurations (sandbox / production keys)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_PRO_MONTHLY="price_..."
STRIPE_PRICE_PRO_ANNUAL="price_..."
STRIPE_PRICE_ENTERPRISE_MONTHLY="price_..."
STRIPE_PRICE_ENTERPRISE_ANNUAL="price_..."

# PayDunya credentials (test/live keys from https://paydunya.com)
# PAYDUNYA_MODE: "test" for sandbox, "live" for production
PAYDUNYA_MODE="test"
PAYDUNYA_MASTER_KEY=""
PAYDUNYA_PRIVATE_KEY=""
PAYDUNYA_PUBLIC_KEY=""
PAYDUNYA_TOKEN=""

# Daily trial expiration API CRON secret
CRON_SECRET="super-secret-cron-token-xyz"

