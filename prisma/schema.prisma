generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── AUTH (Auth.js) ────────────────────────────────────────────

enum UserRole {
  ADMIN
  VENDEUR
  CLIENT
}

model User {
  id              String    @id @default(cuid())
  name            String?
  email           String    @unique
  emailVerified   DateTime? @map("email_verified")
  password        String?
  image           String?
  role            UserRole  @default(CLIENT)
  customerAccountStatus String? @default("ACTIVE") @map("customer_account_status")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  accounts     Account[]
  sessions     Session[]
  vendeur      Vendeur?
  activityLogs ActivityLog[]
  aiGenerations AiGeneration[]
  aiUsages      AiUsage[]
  notifications Notification[]

  @@map("users")
}

model Notification {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String
  title      String
  message    String
  link       String?
  read       Boolean  @default(false)
  boutiqueId String?  @map("boutique_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId, read])
  @@index([userId, createdAt])
  @@map("notifications")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model PasswordResetToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("password_reset_tokens")
}

/// Inscription vendeur EN ATTENTE de vérification e-mail.
/// ⚠️ Table de staging volontairement SÉPARÉE de `users` : tant que l'e-mail
/// n'est pas vérifié, AUCUN User/Vendeur/Boutique n'existe et rien n'apparaît
/// dans l'admin. À la vérification, tout est créé atomiquement puis cette ligne
/// est supprimée. Les lignes expirées sont purgées (aucun compte fantôme).
model PendingRegistration {
  id                String          @id @default(cuid())
  email             String          @unique
  passwordHash      String          @map("password_hash")
  // Identité (étape 2)
  nom               String
  prenom            String
  telephone         String?
  // Boutique (étape 3)
  boutiqueNom       String          @map("boutique_nom")
  secteurActivite   SecteurActivite @map("secteur_activite")
  boutiqueAdresse   String?         @map("boutique_adresse")
  boutiqueTelephone String?         @map("boutique_telephone")
  boutiqueEmail     String?         @map("boutique_email")
  logo              String?         @db.Text // data URL (base64) — rien d'externe avant vérif
  // Vérification (token haché, usage unique, expirant)
  tokenHash         String          @unique @map("token_hash")
  expires           DateTime
  createdAt         DateTime        @default(now()) @map("created_at")

  @@map("pending_registrations")
}

// ─── VENDEUR ───────────────────────────────────────────────────

enum StatutVendeur {
  ACTIF
  SUSPENDU
}

model Vendeur {
  id               String         @id @default(cuid())
  userId           String         @unique @map("user_id")
  nom              String
  prenom           String
  email            String
  telephone        String?
  dateNaissance    DateTime?      @map("date_naissance")
  adresse          String?
  photo            String?
  statut           StatutVendeur  @default(ACTIF)
  nomAffiche       String?        @map("nom_affiche")
  pays             String?
  ville            String?
  bio              String?        @db.Text
  notifications    Json?          @default("{\"commandes\":true,\"ventes\":true,\"clients\":true,\"paiements\":true,\"rapports\":true,\"emails\":true}")
  preferences      Json?          @default("{\"langue\":\"fr\",\"timezone\":\"UTC\",\"dateFormat\":\"DD/MM/YYYY\",\"currencyFormat\":\"FCFA\"}")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  boutiques     Boutique[]
  membres       MembreBoutique[]
  abonnements   Abonnement[]

  @@map("vendeurs")
}

// ─── BOUTIQUE ──────────────────────────────────────────────────

enum SecteurActivite {
  ALIMENTATION
  HABILLEMENT
  ELECTRONIQUE
  BEAUTE
  SANTE
  SERVICES
  QUINCAILLERIE
  LIBRAIRIE
  AUTRE
}

enum StatutBoutique {
  ACTIF
  SUSPENDU
}

model Boutique {
  id               String          @id @default(cuid())
  vendeurId        String          @map("vendeur_id")
  nom              String
  slug             String          @unique
  description      String?         @db.Text
  adresse          String?
  siteWeb          String?         @map("site_web")
  email            String?
  telephone        String?
  latitude         Float?
  longitude        Float?
  secteurActivite  SecteurActivite @map("secteur_activite")
  logo             String?
  banner           String?
  ticketMessage    String?         @map("ticket_message") @db.Text
  /// Personnalisation de la facture (couleur d'accent, mentions, remerciement,
  /// affichage des coordonnées). Null = défauts de la marque.
  factureSettings  Json?           @map("facture_settings")
  statut           StatutBoutique  @default(ACTIF)
  qrCodeUrl        String?         @map("qr_code_url")
  qrCodeGeneratedAt DateTime?      @map("qr_code_generated_at")
  whatsapp         String?
  facebook         String?
  instagram        String?
  linkedin         String?
  twitter          String?
  horaires         String?         @db.Text
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  vendeur          Vendeur         @relation(fields: [vendeurId], references: [id], onDelete: Cascade)
  membres          MembreBoutique[]
  categories       Categorie[]
  produits         Produit[]
  clients          Client[]
  fournisseurs     Fournisseur[]
  commandesClient  CommandeClient[]
  commandesFournisseur CommandeFournisseur[]
  ventesFlash      VenteFlash[]
  mouvementsStock  MouvementStock[]
  depenses         Depense[]
  resumesJournaliers ResumeJournalier[]
  factures         Facture[]

  @@map("boutiques")
}

// ─── RBAC BOUTIQUE ─────────────────────────────────────────────

enum RoleBoutique {
  OWNER
  STAFF
}

model MembreBoutique {
  id         String        @id @default(cuid())
  boutiqueId String        @map("boutique_id")
  vendeurId  String        @map("vendeur_id")
  role       RoleBoutique  @default(STAFF)
  createdAt  DateTime      @default(now()) @map("created_at")

  boutique   Boutique      @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)
  vendeur    Vendeur       @relation(fields: [vendeurId], references: [id], onDelete: Cascade)

  @@unique([boutiqueId, vendeurId])
  // Contrôles d'accès « boutiques de ce vendeur » (chemin critique).
  @@index([vendeurId])
  @@map("membres_boutique")
}

// ─── PLANS & ABONNEMENTS ──────────────────────────────────────

model Plan {
  id                    String       @id @default(cuid())
  nom                   String
  prix                  Float
  dureeEssaiJours       Int          @default(90) @map("duree_essai_jours")
  maxBoutiques          Int          @default(1) @map("max_boutiques")
  maxProduits           Int          @default(100) @map("max_produits")
  maxMembres            Int          @default(1) @map("max_membres")
  codePlan              String?      @map("code_plan")
  features              Json         @default("[]")
  actif                 Boolean      @default(true)
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")

  abonnements           Abonnement[]

  @@map("plans")
}

enum StatutAbonnement {
  EN_ATTENTE
  ESSAI
  ACTIF
  EXPIRE
  ANNULE
}

model Abonnement {
  id                    String            @id @default(cuid())
  vendeurId             String            @map("vendeur_id")
  planId                String            @map("plan_id")
  essaiFin              DateTime?         @map("essai_fin")
  dateDebut             DateTime          @map("date_debut")
  dateFin               DateTime?         @map("date_fin")
  statut                StatutAbonnement  @default(ESSAI)
  moyenPaiement         String?           @map("moyen_paiement")
  montant               Float
  lastReminderAt        DateTime?         @map("last_reminder_at")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  vendeur        Vendeur           @relation(fields: [vendeurId], references: [id], onDelete: Cascade)
  plan           Plan              @relation(fields: [planId], references: [id])
  paiements      Paiement[]

  // Contrôle de quota interrogé à chaque page du dashboard → index vital.
  @@index([vendeurId, statut])
  @@map("abonnements")
}

enum StatutPaiement {
  EN_ATTENTE
  CONFIRME
  ECHOUE
  REMBOURSE
}

model Paiement {
  id                    String          @id @default(cuid())
  abonnementId          String          @map("abonnement_id")
  montant               Float
  methode               String
  statut                StatutPaiement  @default(EN_ATTENTE)
  transactionRef        String?         @map("transaction_ref")
  metadata              Json?           @map("metadata")
  createdAt             DateTime        @default(now()) @map("created_at")

  abonnement     Abonnement      @relation(fields: [abonnementId], references: [id], onDelete: Cascade)

  // Webhook PayTech (recherche par transactionRef) + historique Facturation.
  @@index([transactionRef])
  @@index([abonnementId])
  @@map("paiements")
}

// ─── CATALOGUE ─────────────────────────────────────────────────

model Categorie {
  id         String    @id @default(cuid())
  boutiqueId String    @map("boutique_id")
  nom        String
  couleur    String?
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  boutique   Boutique  @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)
  produits   Produit[]

  @@unique([boutiqueId, nom])
  @@index([boutiqueId, createdAt])
  @@map("categories")
}

model Produit {
  id            String    @id @default(cuid())
  boutiqueId    String    @map("boutique_id")
  categorieId   String?   @map("categorie_id")
  nom           String
  code          String
  description   String    @default("")
  prixAchat     Float     @default(0) @map("prix_achat")
  prixUnitaire  Float     @map("prix_unitaire")
  quantite      Int       @default(0)
  seuilAlerte   Int       @default(5) @map("seuil_alerte")
  photo         String?
  aiGenerated   Boolean   @default(false) @map("ai_generated")
  aiPrompt      String?   @map("ai_prompt") @db.Text
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  boutique      Boutique   @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)
  categorie     Categorie? @relation(fields: [categorieId], references: [id], onDelete: SetNull)

  lignesCommandeClient     LigneCommandeClient[]
  lignesCommandeFournisseur LigneCommandeFournisseur[]
  lignesVenteFlash         LigneVenteFlash[]
  lignesFacture            LigneFacture[]
  mouvementsStock          MouvementStock[]

  @@unique([boutiqueId, code])
  @@index([boutiqueId, createdAt])
  @@index([boutiqueId, updatedAt])
  @@index([createdAt])
  @@index([prixUnitaire])
  @@index([quantite])
  @@map("produits")
}

// ─── TIERS ─────────────────────────────────────────────────────

model Client {
  id         String    @id @default(cuid())
  boutiqueId String    @map("boutique_id")
  nom        String
  prenom     String?
  telephone  String?
  email      String?
  adresse    String?
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  boutique   Boutique  @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)
  commandes  CommandeClient[]
  factures   Facture[]

  @@index([boutiqueId, createdAt])
  @@map("clients")
}

model Fournisseur {
  id         String    @id @default(cuid())
  boutiqueId String    @map("boutique_id")
  nom        String
  telephone  String?
  email      String?
  adresse    String?
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  boutique   Boutique  @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)
  commandes  CommandeFournisseur[]

  @@index([boutiqueId, createdAt])
  @@map("fournisseurs")
}

// ─── TRANSACTIONS ──────────────────────────────────────────────

enum EtatCommande {
  EN_ATTENTE
  VALIDEE
  LIVREE
  ANNULEE
}

model CommandeClient {
  id             String          @id @default(cuid())
  boutiqueId     String          @map("boutique_id")
  clientId       String?         @map("client_id")
  userId         String?         @map("user_id")
  code           String
  date           DateTime        @default(now())
  total          Float           @default(0)
  remise         Float           @default(0)
  montantRecu    Float?          @map("montant_recu")
  monnaieRendue  Float?          @map("monnaie_rendue")
  etat           EtatCommande    @default(EN_ATTENTE)
  statutPaiement StatutPaiement  @default(EN_ATTENTE) @map("statut_paiement")
  modePaiement   String?         @map("mode_paiement")
  paymentToken   String?         @map("payment_token")
  metadata       Json?           @map("metadata")
  notes          String?         @db.Text
  invoiceNumber  String?         @map("invoice_number")
  invoicePdfUrl  String?         @map("invoice_pdf_url")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  boutique   Boutique      @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)
  client     Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  lignes     LigneCommandeClient[]

  @@unique([boutiqueId, code])
  @@index([boutiqueId, date])
  // Repli IPN (recherche par code seul) + « Mes commandes » de l'acheteur.
  @@index([code])
  @@index([userId, createdAt])
  @@map("commandes_client")
}

model LigneCommandeClient {
  id           String         @id @default(cuid())
  commandeId   String         @map("commande_id")
  produitId    String         @map("produit_id")
  quantite     Int
  prixUnitaire Float          @map("prix_unitaire")

  commande     CommandeClient @relation(fields: [commandeId], references: [id], onDelete: Cascade)
  produit      Produit        @relation(fields: [produitId], references: [id])

  @@map("lignes_commande_client")
}

model CommandeFournisseur {
  id             String        @id @default(cuid())
  boutiqueId     String        @map("boutique_id")
  fournisseurId  String        @map("fournisseur_id")
  code           String
  date           DateTime      @default(now())
  total          Float         @default(0)
  etat           EtatCommande  @default(EN_ATTENTE)
  notes          String?       @db.Text
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  boutique       Boutique      @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)
  fournisseur    Fournisseur   @relation(fields: [fournisseurId], references: [id])
  lignes         LigneCommandeFournisseur[]

  @@unique([boutiqueId, code])
  @@index([boutiqueId, date])
  @@map("commandes_fournisseur")
}

model LigneCommandeFournisseur {
  id           String              @id @default(cuid())
  commandeId   String              @map("commande_id")
  produitId    String              @map("produit_id")
  quantite     Int
  prixUnitaire Float               @map("prix_unitaire")

  commande     CommandeFournisseur @relation(fields: [commandeId], references: [id], onDelete: Cascade)
  produit      Produit             @relation(fields: [produitId], references: [id])

  @@map("lignes_commande_fournisseur")
}

model VenteFlash {
  id         String    @id @default(cuid())
  boutiqueId String    @map("boutique_id")
  code       String
  date       DateTime  @default(now())
  nomClient  String?   @map("nom_client")
  total      Float     @default(0)
  createdAt  DateTime  @default(now()) @map("created_at")

  boutique   Boutique  @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)
  lignes     LigneVenteFlash[]

  @@unique([boutiqueId, code])
  @@map("ventes_flash")
}

model LigneVenteFlash {
  id           String     @id @default(cuid())
  venteFlashId String     @map("vente_flash_id")
  produitId    String     @map("produit_id")
  quantite     Int
  prixUnitaire Float      @map("prix_unitaire")

  venteFlash   VenteFlash @relation(fields: [venteFlashId], references: [id], onDelete: Cascade)
  produit      Produit    @relation(fields: [produitId], references: [id])

  @@map("lignes_vente_flash")
}

// ─── STOCK & COMPTABILITÉ ──────────────────────────────────────

enum TypeMouvement {
  ENTREE
  SORTIE
}

model MouvementStock {
  id         String         @id @default(cuid())
  boutiqueId String         @map("boutique_id")
  produitId  String         @map("produit_id")
  type       TypeMouvement
  quantite   Int
  sourceType String?        @map("source_type")
  sourceId   String?        @map("source_id")
  date       DateTime       @default(now())
  createdAt  DateTime       @default(now()) @map("created_at")

  boutique   Boutique       @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)
  produit    Produit        @relation(fields: [produitId], references: [id])

  @@index([boutiqueId, date])
  @@map("mouvements_stock")
}

model Depense {
  id         String    @id @default(cuid())
  boutiqueId String    @map("boutique_id")
  libelle    String
  montant    Float
  date       DateTime  @default(now())
  categorie  String?
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  boutique   Boutique  @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)

  @@index([boutiqueId, date])
  @@map("depenses")
}

model ResumeJournalier {
  id         String   @id @default(cuid())
  boutiqueId String   @map("boutique_id")
  date       DateTime @db.Date
  ventes     Float    @default(0)
  depenses   Float    @default(0)
  benefice   Float    @default(0)

  boutique   Boutique @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)

  @@unique([boutiqueId, date])
  @@map("resumes_journaliers")
}

// ─── MESSAGERIE & CONTACT ─────────────────────────────────────

model ContactMessage {
  id        String   @id @default(cuid())
  nom       String
  email     String
  sujet     String
  message   String   @db.Text
  lu        Boolean  @default(false)
  // Messagerie support (2026-07-06) : visiteur OU vendeur connecté.
  senderType String  @default("VISITEUR") @map("sender_type") // VISITEUR | VENDEUR
  motif      String? // INFOS | ACCES | QUESTION | PROBLEME | SUGGESTION | AUTRE
  telephone  String?
  // Réfs douces (pas de FK : le message survit à la suppression du compte).
  userId     String? @map("user_id")
  vendeurId  String? @map("vendeur_id")
  boutiqueId String? @map("boutique_id")
  statut     String  @default("NOUVEAU") // NOUVEAU | LU | REPONDU | ARCHIVE
  createdAt DateTime @default(now()) @map("created_at")

  replies   ContactReply[]

  @@index([statut, createdAt])
  @@index([email, createdAt])
  @@map("contact_messages")
}

/// Réponses de l'admin (envoyées par e-mail, persistées pour l'historique).
model ContactReply {
  id        String         @id @default(cuid())
  messageId String         @map("message_id")
  body      String         @db.Text
  createdAt DateTime       @default(now()) @map("created_at")

  message   ContactMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("contact_replies")
}

// ─── FACTURES MANUELLES (Pro / Enterprise) ────────────────────

enum StatutFacture {
  BROUILLON
  PAYEE
  IMPAYEE
  ANNULEE
}

model Facture {
  id              String        @id @default(cuid())
  boutiqueId      String        @map("boutique_id")
  clientId        String?       @map("client_id")
  numero          String
  date            DateTime      @default(now())
  statut          StatutFacture @default(BROUILLON)

  // Snapshot client (archivage + clients non enregistrés)
  clientNom       String?       @map("client_nom")
  clientTelephone String?       @map("client_telephone")
  clientEmail     String?       @map("client_email")
  clientAdresse   String?       @map("client_adresse")

  sousTotal       Float         @default(0) @map("sous_total")
  remise          Float         @default(0)
  tauxTva         Float         @default(0) @map("taux_tva") // pourcentage, ex. 18
  montantTva      Float         @default(0) @map("montant_tva")
  total           Float         @default(0)

  stockDeduit     Boolean       @default(false) @map("stock_deduit")
  notes           String?       @db.Text

  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  boutique        Boutique      @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)
  client          Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  lignes          LigneFacture[]

  @@unique([boutiqueId, numero])
  @@index([boutiqueId, date])
  @@index([boutiqueId, statut])
  @@map("factures")
}

model LigneFacture {
  id           String   @id @default(cuid())
  factureId    String   @map("facture_id")
  produitId    String?  @map("produit_id")
  designation  String
  quantite     Int
  prixUnitaire Float    @map("prix_unitaire")

  facture      Facture  @relation(fields: [factureId], references: [id], onDelete: Cascade)
  produit      Produit? @relation(fields: [produitId], references: [id], onDelete: SetNull)

  @@map("lignes_facture")
}

// ─── ASSISTANT IA ──────────────────────────────────────────────

enum AiGenerationType {
  PRODUCT
  DESCRIPTION
  PRICE
  ANALYSIS
  RESTOCK
  INVOICE
  QUOTE
  MARKETING
  CHAT
}

model AiGeneration {
  id         String           @id @default(cuid())
  userId     String           @map("user_id")
  boutiqueId String?          @map("shop_id")
  type       AiGenerationType
  prompt     String           @db.Text
  response   String           @db.Text
  createdAt  DateTime         @default(now()) @map("created_at")

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([boutiqueId, createdAt])
  @@map("ai_generations")
}

model AiUsage {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  month      String // format "AAAA-MM"
  usageCount Int      @default(0) @map("usage_count")
  quota      Int      @default(5)
  updatedAt  DateTime @updatedAt @map("updated_at")

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
  @@map("ai_usage")
}

// ─── AUDIT ─────────────────────────────────────────────────────

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String?  @map("user_id")
  action      String
  subjectType String?  @map("subject_type")
  subjectId   String?  @map("subject_id")
  changes     Json?
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([subjectType, subjectId])
  @@index([userId, createdAt])
  @@map("activity_logs")
}
